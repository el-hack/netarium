{
  "name": "netarium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first observatory for your home network",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts --dev",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test:e2e": "node tests/browser.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7",
    "lucide-react": "^1.64.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  },
  "license": "MIT"
}
